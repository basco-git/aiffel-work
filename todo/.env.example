# .env.example 를 .env 로 복사해서 사용 (.env 는 git에 올리지 않음)

# 저장소 선택: sqlite = 길 A (로컬 todo.db) / supabase = 길 B (클라우드 + 로그인 + RLS)
DB_BACKEND=sqlite

# 서버 주소
HOST=127.0.0.1
PORT=5000

# ---- 길 A: SQLite ----
# 상대경로면 todo 폴더 기준
DB_PATH=./todo.db

# ---- 길 B: Supabase ----
# 대시보드 > Project Settings > API Keys 에서 확인
# 공개용 키(publishable 또는 anon)만 넣는다. service_role / secret 키는 넣지 않는다 (RLS 우회)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 로그인 쿠키 서명용 임의 문자열 (32자 이상). 만드는 법:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
